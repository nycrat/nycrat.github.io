---
import { Image } from "astro:assets";

const { src, alt, title } = Astro.props;
const { postSlug } = Astro.locals;
const ASSET_CDN_URL = `https://${import.meta.env.ASSET_CDN_HOST}`;

const remoteSrc = `${ASSET_CDN_URL}/blog/${postSlug}/${src}`;
---

<figure>
  <Image src={remoteSrc} alt={alt} title={title} widths={[1200]} inferSize />
  <figcaption>{alt}</figcaption>
</figure>

<style>
  figure {
    margin: auto;
  }

  figcaption {
    font-weight: 500;
    font-style: italic;
  }

  img {
    max-width: 100%;
    height: auto;
    border: 1px solid black;
  }

  @media screen and (min-width: 600px) {
    figure {
      width: 75%;
    }
  }
</style>
