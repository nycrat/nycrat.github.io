---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import MarkdownImage from "@components/MarkdownImage.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout pageTitle={post.data.title}>
  <article>
    <h1>{post.data.title}</h1>
    <blockquote>{post.data.subtitle}</blockquote>
    <time datetime={post.data.date.toISOString()}>
      Published {post.data.date.toDateString()}
    </time>
    <br />
    <br />
    <Content components={{ img: MarkdownImage }} />
  </article>
</BaseLayout>

<style>
  time {
    font-style: italic;
    color: var(--gray);
  }

  blockquote {
    font-weight: 500;
    font-style: italic;
  }
</style>
