---
import { getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import MarkdownImage from "@components/MarkdownImage.astro";
import { ASSET_CDN_URL } from "@lib/constants";
import { clampDescription, ogImageFromCdn } from "@lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: post.id },
      props: {
        post,
        ogImage: await ogImageFromCdn(
          `${ASSET_CDN_URL}/blog/${post.id}/${post.data.thumbnail}`,
        ),
      },
    })),
  );
}

const { post, ogImage } = Astro.props;
const { Content } = await render(post);

Astro.locals.postSlug = post.id;
---

<ContentLayout
  pageTitle={post.data.title}
  description={clampDescription(
    `${post.data.subtitle} Topics: ${post.data.tags.join(", ")}.`,
  )}
  ogType="article"
  ogImage={ogImage.src}
  ogImageWidth={ogImage.width}
  ogImageHeight={ogImage.height}
>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <blockquote>{post.data.subtitle}</blockquote>
      <time datetime={post.data.date.toISOString()}>
        Published {post.data.date.toDateString()}
      </time>
    </header>
    <Content components={{ img: MarkdownImage }} />
  </article>
</ContentLayout>

<style>
  time {
    font-style: italic;
    color: var(--gray);
  }

  blockquote {
    font-weight: 500;
    font-style: italic;
  }
</style>
