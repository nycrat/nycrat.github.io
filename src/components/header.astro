---
const links = [
  { href: "/", label: "About" },
  { href: "/photos/", label: "Photos" },
  { href: "/blog/", label: "Blog" },
  { href: "/socials/", label: "Socials" },
];
---

<header>
  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--lightgray);
  }

  ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
