---
import ContentLayout from "@layouts/ContentLayout.astro";
import { Image } from "astro:assets";
import Photos from "./photos.json";
import { ASSET_CDN_URL } from "@lib/constants";
---

<ContentLayout pageTitle="Photography">
  <h1>Photo collections</h1>

  {
    Photos.map((collection) => (
      <div>
        <h2>{collection.name}</h2>
        {collection.images.map((path) => (
          <Image
            src={ASSET_CDN_URL + "/portfolio" + path}
            alt="Some image"
            width={900}
            height={600}
            format="webp"
          />
        ))}
      </div>
    ))
  }
</ContentLayout>
