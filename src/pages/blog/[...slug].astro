---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import MarkdownImage from "@components/MarkdownImage.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

Astro.locals.postSlug = post.id;
---

<BaseLayout pageTitle={post.data.title}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <blockquote>{post.data.subtitle}</blockquote>
      <time datetime={post.data.date.toISOString()}>
        Published {post.data.date.toDateString()}
      </time>
    </header>
    <Content components={{ img: MarkdownImage }} />
  </article>
</BaseLayout>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  time {
    font-style: italic;
    color: var(--gray);
  }

  blockquote {
    font-weight: 500;
    font-style: italic;
  }
</style>
