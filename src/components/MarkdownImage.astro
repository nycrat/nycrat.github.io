---
import { ASSET_CDN_URL } from "@lib/constants";
import { Image } from "astro:assets";

const { src, alt, title } = Astro.props;
const { postSlug } = Astro.locals;

const remoteSrc = `${ASSET_CDN_URL}/blog/${postSlug}/${src}`;
---

<figure>
  <Image src={remoteSrc} alt={alt} title={title} widths={[1200]} inferSize />
  <figcaption>{alt}</figcaption>
</figure>

<style>
  figure {
    margin-inline: auto;
  }

  figcaption {
    font-weight: 500;
    font-style: italic;
  }

  img {
    max-width: 100%;
    height: auto;
    border: 1px solid black;
  }

  @media screen and (min-width: 600px) {
    figure {
      width: 75%;
    }
  }
</style>
