---
import { Image } from "astro:assets";

const { src, alt, title } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} title={title} widths={[1200]} inferSize />
  <figcaption>{alt}</figcaption>
</figure>

<style>
  figure {
    margin: auto;
  }

  figcaption {
    font-weight: 500;
    font-style: italic;
  }

  img {
    max-width: 100%;
    height: auto;
    border: 1px solid black;
  }

  @media screen and (min-width: 600px) {
    figure {
      width: 75%;
    }
  }
</style>
