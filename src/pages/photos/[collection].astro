---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  firstPhoto,
  photoAlt,
  photoCollections,
  photoUrl,
  type PhotoCollection,
} from "@lib/photos";
import { ogImageFromCdn } from "@lib/seo";

export async function getStaticPaths() {
  return Promise.all(
    photoCollections.map(async (collection, index) => ({
      params: { collection: collection.slug },
      props: {
        collection,
        index,
        ogImage: await ogImageFromCdn(
          photoUrl(collection.slug, firstPhoto(collection)),
        ),
      },
    })),
  );
}

interface Props {
  collection: PhotoCollection;
  index: number;
  ogImage: Awaited<ReturnType<typeof ogImageFromCdn>>;
}

const { collection, ogImage } = Astro.props;
---

<BaseLayout
  pageTitle={collection.name}
  description={`A photo collection: ${collection.name} by Avah Xiao.`}
  ogImage={ogImage.src}
  ogImageWidth={ogImage.width}
  ogImageHeight={ogImage.height}
>
  <main>
    <ul class="photos">
      {
        collection.images.map((image, imageIndex) => (
          <li>
            <Image
              src={photoUrl(collection.slug, image)}
              alt={photoAlt(image)}
              widths={[1200]}
              inferSize
              priority={imageIndex === 0}
            />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .photos {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 1;
    column-gap: 0.25rem;
  }

  .photos li {
    margin-bottom: 0.25rem;
  }

  @media screen and (min-width: 600px) {
    .photos {
      columns: 2;
    }
  }

  @media screen and (min-width: 1000px) {
    .photos {
      columns: 3;
    }
  }
</style>
