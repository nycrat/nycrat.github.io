---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { firstPhoto, photoCollections, photoUrl } from "@lib/photos";
import { ogImageFromCdn } from "@lib/seo";

const [first] = photoCollections;

if (!first) {
  throw new Error("photos.json contains no collections");
}

const ogImage = await ogImageFromCdn(photoUrl(first.slug, firstPhoto(first)));
---

<BaseLayout
  pageTitle="Photography"
  description="Photography collections by Avah Xiao."
  ogImage={ogImage.src}
  ogImageWidth={ogImage.width}
  ogImageHeight={ogImage.height}
>
  <main class="grid">
    {
      photoCollections.map((collection, i) => (
        <a class="preview" href={`/photos/${collection.slug}/`}>
          <div class="title">{collection.name}</div>
          <Image
            src={photoUrl(collection.slug, firstPhoto(collection))}
            alt=""
            widths={[1200]}
            inferSize
            priority={i === 0}
          />
        </a>
      ))
    }
  </main>
</BaseLayout>

<style>
  img {
    aspect-ratio: 3/2;
  }

  .preview {
    position: relative;
  }

  .title {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);

    white-space: nowrap;
    color: white;
    font-size: 2.5rem;
  }

  .grid {
    display: grid;
    gap: 0.25rem;
  }

  @media screen and (min-width: 600px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
